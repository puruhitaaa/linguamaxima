# LinguaMaxima API Environment Configuration

# --- App Settings ---
APP_NAME="LinguaMaxima API"
DEBUG=false
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001","https://your-frontend-domain.vercel.app"]

# --- Execution Mode ---
# Set to true for Vercel / Serverless deployments
IS_SERVERLESS=false
AUTO_INIT_DB=true
AUTO_SEED_DB=true

# --- Database ---
# Local / Containerized PostgreSQL
DATABASE_URL=postgresql+asyncpg://linguamaxima:linguamaxima@localhost:5433/linguamaxima
# Supabase Transaction Pooler (Serverless):
# DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?ssl=require
# Neon Database (Serverless):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?ssl=require
USE_SQLITE_FALLBACK=true

# --- AI & LLM Providers (LiteLLM) ---
DEFAULT_AI_MODEL=gemini/gemini-3.5-flash
FALLBACK_AI_MODEL=groq/openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=
PIXABAY_API_KEY=your_pixabay_api_key_here

# --- Audio Storage Backend ("local" or "r2") ---
# Use "local" for Docker / Local dev; "r2" for Serverless / Cloudflare R2
AUDIO_STORAGE_BACKEND=local

# --- Cloudflare R2 Configuration (Required when AUDIO_STORAGE_BACKEND=r2) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=linguamaxima-audio
R2_PUBLIC_URL_PREFIX=https://pub-your-bucket-hash.r2.dev
